{
  "name": "hello-kitty-pet",
  "version": "1.0.0",
  "description": "Hello Kitty desktop pet built with Vue, Vite, and Electron.",
  "author": "lixian",
  "license": "MIT",
  "productName": "Hello Kitty 桌宠",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-store": "^10.0.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^35.7.5",
    "electron-builder": "^24.13.3",
    "vite": "^6.4.2"
  },
  "build": {
    "appId": "com.desktop.hellokitty",
    "productName": "Hello Kitty 桌宠",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
